{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar archivo activo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/main.exe", // Ejecutable en la misma carpeta del archivo activo
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}", // Usa la carpeta del archivo activo como directorio de trabajo
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar impresión detallada de estructuras",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Compilar archivo activo" // Llama a la tarea de compilación
        }
    ]
}

