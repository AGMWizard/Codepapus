{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar archivo activo",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${file}", 
                "-o",
                "${fileDirname}/main.exe" 
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compila el archivo C++ actualmente abierto"
        }
    ]
}


